# Frontend (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:3000
# Leave empty in local dev so /api goes through Vite (Jira middleware + optional AI proxy)
VITE_AI_PROXY_URL=

# Leave Supabase empty to use localStorage mode.
# When both URL and anon key are set, the app uses Supabase Auth + Postgres.

# AI proxy server (never put GEMINI_API_KEY or JIRA_API_TOKEN in VITE_*)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PORT=8787

# Real Jira Cloud (used by ai-server when client confirms Create on Jira)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=KAN
JIRA_ISSUE_TYPE=Task
