# Frontend (public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:3000
VITE_AI_PROXY_URL=http://localhost:8787

# Leave Supabase empty to use localStorage mode.
# When both URL and anon key are set, the app uses Supabase Auth + Postgres.

# AI proxy server (never put GEMINI_API_KEY in VITE_*)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PORT=8787
